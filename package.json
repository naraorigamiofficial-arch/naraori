{
  "name": "naraori",
  "version": "1.0.0",
  "private": true,
  "description": "Nara Origami: the website of origami artist Abhijeet S. Vashistha and the Nara Origami Originals paper studio.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --trace off",
    "check": "npm run typecheck && npm run lint && npm test",
    "studio:password": "node scripts/hash-password.mjs",
    "test:db": "bash tests/db/run.sh"
  },
  "engines": {
    "node": ">=20.9"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.0",
    "gray-matter": "4.0.3",
    "marked": "18.1.3",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.37.0",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
