# Copy to .env.local for local development, and add the same names in Vercel
# (Project > Settings > Environment Variables). Never commit real values.

# ---- Site ----
# Canonical address used in metadata, sitemap and emails.
NEXT_PUBLIC_SITE_URL=https://naraori.in
# Public studio address shown on the site. Defaults to naraorigami.official@gmail.com.
NEXT_PUBLIC_STUDIO_EMAIL=
# Optional: Google Search Console HTML-tag verification code (just the content value).
GOOGLE_SITE_VERIFICATION=

# ---- Supabase (order requests, enquiries, editable prices) ----
# Project URL, e.g. https://abcdefghijkl.supabase.co
SUPABASE_URL=
# SECRET key (sb_secret_... or the legacy service_role key). Server only. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ---- Resend (emails) ----
RESEND_API_KEY=
# Sender on your VERIFIED Resend domain. Use a real mailbox customers can reply to, not no-reply.
# e.g.  Nara Origami Originals <studio@naraori.in>
EMAIL_FROM=
# Where replies from customers should go (defaults to STUDIO_NOTIFY_EMAIL).
EMAIL_REPLY_TO=
# Inbox that receives new order requests and enquiries.
STUDIO_NOTIFY_EMAIL=

# ---- Studio dashboard (/studio) ----
# Generate both with:  npm run studio:password -- "a long passphrase only you know"
STUDIO_ADMIN_PASSWORD_HASH=
STUDIO_SESSION_SECRET=

# ---- Scheduled email retries (Vercel Cron calls /api/cron/notifications) ----
# Any long random string. Vercel sends it automatically as a Bearer token.
CRON_SECRET=

# ---- Development / testing only ----
# NARA_FILE_STORE=1        use a local JSON file instead of Supabase (automatic in `npm run dev`)
# NARA_DATA_DIR=.data      where that file and captured emails are written
